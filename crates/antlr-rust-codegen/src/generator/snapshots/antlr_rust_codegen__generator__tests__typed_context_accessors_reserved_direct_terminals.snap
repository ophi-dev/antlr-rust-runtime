    pub fn direct_terminals_rule_child(&self) -> Result<DirectTerminalsContext<'a>, MissingChildError> {
        __rule_children(self.__node, 1)
            .next()
            .map(|node| DirectTerminalsContext::__from_child_node(node, self.__invocation_states.as_deref()))
            .ok_or_else(|| MissingChildError::new("StartContext", "directTerminals"))
    }
    pub fn labeled(&self) -> Result<LabeledContext<'a>, MissingChildError> {
        __rule_children(self.__node, 2)
            .next()
            .map(|node| LabeledContext::__from_child_node(node, self.__invocation_states.as_deref()))
            .ok_or_else(|| MissingChildError::new("StartContext", "labeled"))
    }
    pub fn eof_token(&self) -> Result<TerminalNode<'a>, MissingChildError> {
        __token_children(self.__node, -1)
            .next()
            .map(TerminalNode::new)
            .ok_or_else(|| MissingChildError::new("StartContext", "EOF"))
    }
}

